# /etc/ghost/node-list-merge.env — read by ghost-node-list-merge.service (the website host).
# Not secret: lister URLs are public and the DNS hook keeps its own credentials.
#
# One --lister per lister: a node running `install-node.sh --lister` serves its list at
# http://<node>:8080/api/v1/node-pool/node-list. A node is listed only when MORE THAN HALF of the
# listers named here list it; one that is down votes for nothing, so an outage can only shrink the
# list, and with fewer than half answering nothing is written or pushed.
#
# --dns-name must equal NAMECHEAP_HOST in /etc/ghost/namecheap.env.
GHOST_MERGE_ARGS=--network mainnet --lister http://203.0.113.11:8080/api/v1/node-pool/node-list --lister http://203.0.113.12:8080/api/v1/node-pool/node-list --lister http://203.0.113.13:8080/api/v1/node-pool/node-list --dns-name pool --dns-ttl 300 --dns-hook /opt/ghost/bin/namecheap-hook.py

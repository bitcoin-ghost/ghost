# /etc/ghost/namecheap.env — credentials for namecheap-hook.py. KEEP IT PRIVATE:
#   sudo install -m 600 -o ghost-merge -g ghost-merge namecheap.env.example /etc/ghost/namecheap.env
# The hook refuses to run if this file is readable by anyone but its owner, or is not owned by
# the user running it (ghost-merge). Nothing the hook prints contains these values.
#
# API access: Namecheap account > Profile > Tools > Namecheap API Access: turn it on, copy the
# key, and WHITELIST this server's public IPv4 (the same as NAMECHEAP_CLIENT_IP). Calls from any
# other IP are refused (error 1011150).
NAMECHEAP_API_USER=your-api-user
NAMECHEAP_API_KEY=your-api-key
NAMECHEAP_USERNAME=your-account-user
NAMECHEAP_CLIENT_IP=203.0.113.20
NAMECHEAP_DOMAIN=bitcoinghost.org
# The ONE name the hook owns: only its A and AAAA records are ever changed.
NAMECHEAP_HOST=pool
# 1 lets a fragment with no records remove the name's addresses. Default 0: refused.
NAMECHEAP_ALLOW_EMPTY=0
# Sandbox while trying it out: https://api.sandbox.namecheap.com/xml.response
# NAMECHEAP_API_URL=https://api.namecheap.com/xml.response

[Unit]
Description=Ghost Pool website API proxy (the pool's own nodes, read routes only)
Documentation=https://bitcoinghost.org/run-a-node.html
# For the WEBSITE host, not a node: nginx hands it /api/pool/<id>/... (scripts/website-proxy/
# nginx-site-proxy.conf). It forwards GETs of the pages' read routes only, only to the nodes in
# /etc/ghost/site-proxy-nodes.json (read once at start; restart after editing it), on each node's
# fixed API port. Install the script as /opt/ghost/bin/ghost-site-proxy (from
# scripts/website-proxy/ghost-site-proxy.py).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -I /opt/ghost/bin/ghost-site-proxy --listen 127.0.0.1:8791 --nodes /etc/ghost/site-proxy-nodes.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryMax=256M

[Install]
WantedBy=multi-user.target

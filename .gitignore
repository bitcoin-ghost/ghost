# Wraith Wallet Tauri sidecars — staged at build time from freshly-built
# wraithd binaries (target-triple-suffixed), never committed.
apps/wraith-wallet/gui/src-tauri/binaries/
build/

# Python bytecode (the SV1 smoke self-test imports the smoke module)
__pycache__/
*.pyc

# ghost-gsp writes its SQLite databases to a data_dir that defaults to a RELATIVE path
# (`./gsp-data`, crates/ghost-gsp/src/server.rs:453), so running the test suite from the repo root
# creates crates/ghost-gsp/gsp-data/ and leaves it behind. That dirtied the working tree, and
# scripts/record-tests.sh refuses a dirty tree — so a plain `cargo test` could block the very gate
# that has to run before a deploy, with a cause that looks unrelated.
gsp-data/

# Regtest-cluster binaries: build artifacts, never source.
#
# 44MB of compiled binaries were tracked here. Once pushed, a binary is in the history
# permanently, and a tracked one goes stale silently — this copy of ghost-pool sat at
# v1.10.22 while the tree was v1.11.22, so a cluster run would have reported success
# against code months older than the change under test.
#
# docker-compose.yml bind-mounts these, so they must still EXIST on disk; rebuild with:
#   cargo build --release -p ghost-pool && cp target/release/ghost-pool docker/regtest-cluster/bin/
docker/regtest-cluster/bin/

# SV2 integration-test fixtures, downloaded and extracted at run time (#617).
# 201 MB of them — a full bitcoin-30.2 distribution, an sv2-tp build and LevelDB chainstate —
# were committed by accident in 8b77fb352 because the tests populate this directory and a
# `git add -A` swept it in. They are build products, not source: the harness fetches them.
tests/integration-sv2/template-provider/
